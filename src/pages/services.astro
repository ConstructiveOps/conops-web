---
// Services — copy: src/content/pages/services.md + src/content/services/*.md
import SiteLayout from '../layouts/SiteLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import ServiceList from '../components/ServiceList.astro';
import SundialSection from '../components/SundialSection.astro';
import BookDemoButton from '../components/BookDemoButton.astro';
import { getPage } from '../lib/content';

const { title, description, heading, intro } = (await getPage('services')).data;
---

<SiteLayout title={title} description={description}>
  <PageIntro heading={heading} intro={intro}>
    <div class="mt-8"><BookDemoButton size="lg" label="Book a 30-minute demo" /></div>
  </PageIntro>
  <section aria-label="Services" class="mx-auto max-w-[1240px] px-4 py-20 sm:px-[6vw] xl:px-0">
    <ServiceList />
  </section>
  {/* No accent here: the amber accent is for Sundial pages and the home Sundial section only. */}
  <SundialSection />
</SiteLayout>
