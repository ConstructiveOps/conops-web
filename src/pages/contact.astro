---
// Contact — copy: src/content/pages/contact.md. Form submit address (api/contact.ts):
// src/data/site.ts → contactFormEndpoint.
import SiteLayout from '../layouts/SiteLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import BookDemoButton from '../components/BookDemoButton.astro';
import ContactForm from '../components/islands/ContactForm.tsx';
import { getPage } from '../lib/content';
import { site } from '../data/site';

const { title, description, heading, intro } = (await getPage('contact')).data;
---

<SiteLayout title={title} description={description}>
  <PageIntro heading={heading} intro={intro}>
    <div class="mt-8"><BookDemoButton size="lg" label="Book a 30-minute demo" /></div>
  </PageIntro>

  <section aria-label="Contact form and details" class="mx-auto grid max-w-[1240px] gap-12 px-4 py-20 sm:px-[6vw] md:grid-cols-3 xl:px-0">
    <div class="md:col-span-2">
      <h2 class="font-heading text-2xl font-bold lowercase text-navy">send a message.</h2>
      <div class="mt-4">
        <ContactForm
          client:visible
          endpoint={site.contactFormEndpoint}
          isDev={import.meta.env.DEV}
          email={site.company.email}
          phone={site.company.phone}
          bookingUrl={site.bookingUrl}
        />
      </div>
    </div>
    <div>
      <h2 class="font-heading text-2xl font-bold lowercase text-navy">reach us.</h2>
      <address class="mt-4 space-y-2 not-italic text-ink-soft">
        {site.company.address.map((line) => <p>{line}</p>)}
        <p>Email: <a class="text-navy underline" href={`mailto:${site.company.email}`}>{site.company.email}</a></p>
        <p>Phone: <a class="text-navy underline" href={site.company.phoneHref}>{site.company.phone}</a></p>
      </address>
    </div>
  </section>
</SiteLayout>
