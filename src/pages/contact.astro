---
// Contact — copy: src/content/pages/contact.md. Form submit address:
// src/data/site.ts → contactFormEndpoint (empty = not connected yet).
import SiteLayout from '../layouts/SiteLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import BookDemoButton from '../components/BookDemoButton.astro';
import ContactForm from '../components/islands/ContactForm.tsx';
import { getPage } from '../lib/content';
import { site } from '../data/site';

const { title, description, heading, intro } = (await getPage('contact')).data;
---

<SiteLayout title={title} description={description}>
  <PageIntro heading={heading} intro={intro}>
    <div class="mt-6"><BookDemoButton label="Book a 30-minute demo" /></div>
  </PageIntro>

  <section aria-label="Contact form and details" class="mx-auto grid max-w-6xl gap-12 px-4 pb-20 sm:px-6 md:grid-cols-3">
    <div class="md:col-span-2">
      <h2 class="font-heading text-xl font-bold lowercase text-navy">send a message.</h2>
      <div class="mt-4 min-h-[28rem]">
        <ContactForm
          client:visible
          endpoint={site.contactFormEndpoint}
          isDev={import.meta.env.DEV}
          email={site.company.email}
          bookingUrl={site.bookingUrl}
        />
      </div>
    </div>
    <div>
      <h2 class="font-heading text-xl font-bold lowercase text-navy">reach us.</h2>
      <address class="mt-4 space-y-2 not-italic text-ink-muted">
        {site.company.address.map((line) => <p>{line}</p>)}
        <p>Email: <a class="text-navy underline" href={`mailto:${site.company.email}`}>{site.company.email}</a></p>
        <p>Phone: <a class="text-navy underline" href={site.company.phoneHref}>{site.company.phone}</a></p>
      </address>
    </div>
  </section>
</SiteLayout>
