---
import SiteLayout from '../layouts/SiteLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
---

<SiteLayout title="Page not found | Constructive Operations" description="Page not found.">
  <div class="mx-auto max-w-6xl px-4 py-24 sm:px-6">
    <SectionHeading text="not found." level={1} />
    <p class="mt-4 text-lg text-ink-muted">That page doesn't exist. <a class="text-navy underline" href="/">Go to the home page</a>.</p>
  </div>
</SiteLayout>
