---
import SiteLayout from '../layouts/SiteLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import BookDemoButton from '../components/BookDemoButton.astro';
---

<SiteLayout title="Page not found | Constructive Operations" description="Page not found.">
  <div class="bg-surface-gray">
    <div class="mx-auto max-w-[1240px] px-4 py-28 sm:px-[6vw] xl:px-0">
      <SectionHeading text="not found." level={1} />
      <p class="mt-4 text-[19px] text-ink-soft">That page doesn't exist. <a class="text-navy underline" href="/">Go to the home page</a>.</p>
      <div class="mt-8"><BookDemoButton size="lg" /></div>
    </div>
  </div>
</SiteLayout>
