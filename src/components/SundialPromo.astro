---
// Sundial section shown on Constructive Operations pages (home, services).
// Links to sundialcrm.com. The logo PNG has a baked-in off-white background,
// so it sits on a matching bg-sundial-panel card.
import { Image } from 'astro:assets';
import { getEntry } from 'astro:content';
import SectionHeading from './SectionHeading.astro';
import Text from './Text.astro';
import { sundialUrl } from '../lib/urls';
import sundialLogo from '../assets/brand/sundial-logo.png';

const promo = await getEntry('pages', 'sundial-promo');
if (!promo) throw new Error('Missing src/content/pages/sundial-promo.md');
const { heading, intro } = promo.data;
---

<section id="sundial" aria-labelledby="sundial-heading" class="bg-surface-alt">
  <div class="mx-auto grid max-w-6xl items-center gap-10 px-4 py-16 sm:px-6 md:grid-cols-2">
    <div class="rounded-lg bg-sundial-panel p-6 shadow-sm">
      <Image src={sundialLogo} alt="Sundial — Operations Intelligence" widths={[360, 540, 720]} sizes="(min-width: 768px) 480px, 90vw" class="h-auto w-full" />
    </div>
    <div>
      <SectionHeading id="sundial-heading" text={heading} />
      <div class="mt-4 space-y-4 text-lg text-ink-muted">
        {intro.map((p) => <Text text={p} />)}
      </div>
      <a href={sundialUrl('/')} class="mt-6 inline-flex items-center gap-2 font-heading font-semibold text-navy underline underline-offset-4">
        Learn about Sundial <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</section>
