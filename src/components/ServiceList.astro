---
// The six service cards (src/content/services/*.md, in `order`): black icon
// disc, title, one-sentence summary, and the five points from the deck.
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
const icons = import.meta.glob<{ default: ImageMetadata }>('../assets/process/icon*.png', { eager: true });
const iconFor = (name: string) => icons[`../assets/process/${name}.png`]?.default;
---

<ul class="grid gap-5 sm:grid-cols-2 xl:grid-cols-3">
  {
    services.map((s) => {
      const icon = iconFor(s.data.icon);
      return (
        <li class="flex flex-col gap-3 rounded border border-line border-t-4 border-t-navy bg-white p-7" data-reveal>
          <div class="flex items-center gap-4">
            {icon && <Image src={icon} alt="" width={56} height={56} class="size-14 shrink-0" />}
            <h3 class="font-display text-xl leading-tight text-navy">{s.data.title}</h3>
          </div>
          <p class="text-base text-ink-muted">{s.data.summary}</p>
          <ul class="mt-1 space-y-1.5 border-t border-line pt-3 text-[15px] text-ink-soft">
            {s.data.points.map((p) => (
              <li class="flex gap-2.5">
                <span aria-hidden="true" class="mt-[9px] size-1.5 shrink-0 rounded-full bg-navy" />
                <span>{p}</span>
              </li>
            ))}
          </ul>
        </li>
      );
    })
  }
</ul>
