---
// Home hero: the solar operations process (design-reference/hero-process.reference.html).
//
// Motion: plays ONCE when the process scrolls into view, then holds its
// finished state; a small Replay button replays it. Without JavaScript, or
// under prefers-reduced-motion, the finished state shows with no animation
// (the starting state applies only under html.reveal-on, which BaseLayout
// adds in the head when motion is allowed).
// Only opacity/transform animate, so nothing shifts.
//
// Layout: horizontal process at 900px and wider; a vertical timeline below
// 900px with the same labels. Copy: src/data/process.ts.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BookDemoButton from './BookDemoButton.astro';
import Rings from './Rings.astro';
import { processSteps, processCopy as copy } from '../data/process';

const icons = import.meta.glob<{ default: ImageMetadata }>('../assets/process/icon*.png', { eager: true });
const iconFor = (name: string) => {
  const mod = icons[`../assets/process/${name}.png`];
  if (!mod) throw new Error(`Missing process icon ${name}`);
  return mod.default;
};
const ours = processSteps.reduce((n, s) => n + s.ours.length, 0);
const yours = processSteps.reduce((n, s) => n + s.yours.length, 0);
---

<section id="top" class="hero on-dark relative overflow-hidden bg-navy text-white" data-process aria-labelledby="hero-heading">
  <Rings variant="hero" />

  <div class="relative mx-auto max-w-[1440px] px-4 pb-8 pt-6 sm:px-[56px]">
    <div class="flex flex-wrap items-end justify-between gap-x-12 gap-y-6">
      <div class="flex max-w-[800px] flex-col gap-3.5">
        <p class="text-base text-on-navy">
          <span class="font-bold text-white">{copy.definition.word}</span>{" "}
          <span class="italic">({copy.definition.partOfSpeech})</span>
          &nbsp;1. {copy.definition.meaning}
        </p>
        <h1 id="hero-heading" class="font-display text-[34px] leading-[1.12] text-white sm:text-[46px]">{copy.heading}</h1>
        <p class="text-lg leading-normal text-on-navy">{copy.intro}</p>
      </div>
      <div class="flex flex-col items-start gap-3 pb-1.5 min-[900px]:items-end">
        <BookDemoButton variant="white" size="lg" label={copy.cta} />
        <p class="count text-[15px] text-white min-[900px]:text-right">
          <span class="font-bold">{ours} steps</span> handled by our team. <span class="font-bold">{yours}</span> by yours.
        </p>
      </div>
    </div>

    <div class="mt-10 min-[900px]:mt-6">
      <p class="team-label flex items-baseline gap-3.5 px-2">
        <span class="text-[26px] font-bold text-white sm:text-[30px]">{copy.ourTeam.label}</span>
        <span class="text-sm text-on-navy">{copy.ourTeam.note}</span>
      </p>

      <ol class="steps" aria-label="Solar operations process, from contract to post-activation service">
        {
          processSteps.map((step, i) => (
            <li class="step" style={`--i:${i}`}>
              <div class="above">
                <span class="sr-only">Our team: </span>
                {step.ours.map((label) => (
                  <span class="lbl">{label}</span>
                ))}
                <span class="tick" aria-hidden="true" />
              </div>
              <div class="disc">
                <Image src={iconFor(step.icon)} alt={step.alt} width={104} height={104} loading="eager" />
              </div>
              <div class="below">
                {step.yours.length > 0 && <span class="tick" aria-hidden="true" />}
                {step.yours.map((label) => (
                  <span class="lbl lbl-yours">
                    <span class="yours-tag">
                      <span class="sr-only">Your team: </span>
                      <span aria-hidden="true">your team</span>
                    </span>
                    {label}
                  </span>
                ))}
              </div>
            </li>
          ))
        }
      </ol>

      <p class="team-label flex items-baseline gap-3.5 px-2">
        <span class="text-[26px] font-bold text-on-navy-muted sm:text-[30px]">{copy.yourTeam.label}</span>
        <span class="text-sm text-on-navy-muted">{copy.yourTeam.note}</span>
      </p>
    </div>

    <button
      type="button"
      data-replay
      hidden
      class="absolute bottom-4 right-4 inline-flex items-center gap-1.5 rounded border border-white/50 px-3 py-1.5 text-[13px] text-white hover:bg-white/10 sm:right-[56px]"
    >
      <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M3 12a9 9 0 1 0 3-6.7" /><path d="M3 3v6h6" />
      </svg>
      Replay<span class="sr-only"> the process animation</span>
    </button>
  </div>
</section>

<script is:inline>
  (function () {
    var root = document.querySelector('[data-process]');
    if (!root || !('IntersectionObserver' in window)) return;
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    // html.reveal-on (set in BaseLayout's head when motion is allowed) hides
    // the steps before first paint; this script only starts the play.
    if (!document.documentElement.classList.contains('reveal-on')) return;
    var btn = root.querySelector('[data-replay]');
    var io = new IntersectionObserver(
      function (entries) {
        if (entries[0].isIntersecting) {
          root.classList.add('playing');
          if (btn) btn.hidden = false;
          io.disconnect();
        }
      },
      { threshold: 0.25 }
    );
    io.observe(root.querySelector('.steps'));
    if (btn) {
      btn.addEventListener('click', function () {
        root.classList.remove('playing');
        void root.offsetWidth; // restart the CSS animations
        root.classList.add('playing');
      });
    }
  })();
</script>

<style>
  /* ---------- Layout: horizontal process (900px and wider) ---------- */
  .steps {
    position: relative;
    display: grid;
    grid-template-columns: repeat(10, minmax(0, 1fr));
    grid-template-rows: auto auto auto;
    margin: 8px 0;
  }
  .step {
    display: grid;
    grid-row: span 3;
    grid-template-rows: subgrid;
    justify-items: center;
    min-width: 0;
  }
  .above,
  .below {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    width: 100%;
    padding: 0 5px;
    text-align: center;
  }
  .above { justify-content: flex-end; min-height: 120px; }
  .below { justify-content: flex-start; min-height: 80px; }
  .lbl { font-size: 13px; line-height: 1.3; font-weight: 500; color: #ffffff; }
  .lbl-yours { color: var(--color-on-navy-muted); }
  .yours-tag { display: none; }
  .tick { width: 1px; height: 16px; background: var(--color-brand-gray); flex: none; }

  .disc { position: relative; display: flex; justify-content: center; width: 100%; padding: 6px 0; }
  .disc::before,
  .disc::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 0;
    right: 0;
    height: 4px;
    margin-top: -2px;
    border-radius: 2px;
    background: var(--color-navy-track);
  }
  .disc::after { background: #ffffff; transform-origin: left center; }
  .step:first-child .disc::before,
  .step:first-child .disc::after { left: 50%; }
  .step:last-child .disc::before,
  .step:last-child .disc::after { right: 50%; }
  .disc :global(img) {
    position: relative;
    z-index: 1;
    width: clamp(64px, 7.2vw, 104px);
    height: clamp(64px, 7.2vw, 104px);
  }
  @media (max-width: 1199px) {
    .lbl { font-size: 12px; }
  }

  /* ---------- Layout: vertical timeline (below 900px) ---------- */
  @media (max-width: 899px) {
    .steps { display: block; margin: 16px 0; }
    .step {
      position: relative;
      display: grid;
      grid-template-columns: 72px 1fr;
      grid-template-rows: auto auto;
      column-gap: 16px;
      justify-items: start;
      padding-bottom: 20px;
    }
    .step::before,
    .step::after {
      content: '';
      position: absolute;
      left: 34px;
      width: 4px;
      top: 0;
      bottom: 0;
      border-radius: 2px;
      background: var(--color-navy-track);
    }
    .step::after { background: #ffffff; transform-origin: center top; }
    .step:first-child::before,
    .step:first-child::after { top: 36px; }
    .step:last-child::before,
    .step:last-child::after { bottom: calc(100% - 36px); }
    .disc { grid-column: 1; grid-row: 1 / span 2; width: 72px; padding: 0; align-self: start; }
    .disc::before,
    .disc::after { display: none; }
    .disc :global(img) { width: 72px; height: 72px; }
    .above,
    .below { align-items: flex-start; text-align: left; padding: 0; min-height: 0; gap: 4px; }
    .above { grid-column: 2; grid-row: 1; justify-content: center; min-height: 72px; }
    .below { grid-column: 2; grid-row: 2; padding-top: 6px; }
    .tick { display: none; }
    .lbl { font-size: 15px; }
    .yours-tag {
      display: inline-block;
      margin-right: 8px;
      padding: 0 6px;
      border: 1px solid var(--color-brand-gray);
      border-radius: 3px;
      font-size: 11px;
      font-weight: 500;
      letter-spacing: 0.04em;
      text-transform: lowercase;
      color: var(--color-on-navy-muted);
      vertical-align: 1px;
    }
  }

  /* ---------- Motion (only under html.reveal-on; .playing is added by the script) ---------- */
  :global(html.reveal-on) .hero .above,
  :global(html.reveal-on) .hero .below { opacity: 0; transform: translateY(14px); }
  :global(html.reveal-on) .hero .disc :global(img) { opacity: 0.28; transform: scale(0.82); }
  :global(html.reveal-on) .hero .disc::after { transform: scaleX(0); }
  :global(html.reveal-on) .hero .count { opacity: 0; transform: translateY(10px); }

  :global(html.reveal-on) .hero.playing .above,
  :global(html.reveal-on) .hero.playing .below {
    animation: rise 0.5s ease-out both;
    animation-delay: calc(var(--i) * 0.55s + 0.3s);
  }
  :global(html.reveal-on) .hero.playing .disc :global(img) {
    animation: pop 0.5s ease-out both;
    animation-delay: calc(var(--i) * 0.55s + 0.3s);
  }
  :global(html.reveal-on) .hero.playing .disc::after {
    animation: lineX 0.55s linear both;
    animation-delay: calc(var(--i) * 0.55s + 0.3s);
  }
  :global(html.reveal-on) .hero.playing .count { animation: rise 0.6s ease-out both; animation-delay: 6.1s; }

  @media (max-width: 899px) {
    :global(html.reveal-on) .hero .step::after { transform: scaleY(0); }
    :global(html.reveal-on) .hero.playing .step::after {
      animation: lineY 0.55s linear both;
      animation-delay: calc(var(--i) * 0.55s + 0.3s);
    }
  }

  @keyframes rise {
    from { opacity: 0; transform: translateY(14px); }
    to { opacity: 1; transform: none; }
  }
  @keyframes pop {
    0% { opacity: 0.28; transform: scale(0.82); }
    50% { opacity: 1; transform: scale(1.1); }
    100% { opacity: 1; transform: scale(1); }
  }
  @keyframes lineX {
    from { transform: scaleX(0); }
    to { transform: scaleX(1); }
  }
  @keyframes lineY {
    from { transform: scaleY(0); }
    to { transform: scaleY(1); }
  }

  /* Belt and braces: never animate for people who asked for less motion. */
  @media (prefers-reduced-motion: reduce) {
    :global(html.reveal-on) .hero .above,
    :global(html.reveal-on) .hero .below,
    :global(html.reveal-on) .hero .count,
    :global(html.reveal-on) .hero .disc :global(img),
    :global(html.reveal-on) .hero .disc::after,
    :global(html.reveal-on) .hero .step::after { animation: none !important; opacity: 1 !important; transform: none !important; }
  }
</style>
