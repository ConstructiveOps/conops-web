---
// Footer for both brands. The Client Portal Login link appears on the
// Constructive Operations footer ONLY — never on Sundial pages.
import { Image } from 'astro:assets';
import { site } from '../data/site';
import { coUrl, sundialUrl } from '../lib/urls';
import coLogoWhite from '../assets/brand/co-logo-dark.png';
import sundialLogoWhite from '../assets/brand/sundial-logo-white.png';

interface Props {
  brand: 'co' | 'sundial';
}
const { brand } = Astro.props;
const year = new Date().getFullYear();
const co = (path: string) => (brand === 'co' ? path : coUrl(path));
const link = 'text-white underline underline-offset-4 hover:text-on-navy';
---

<footer class="on-dark bg-navy text-white">
  {
    brand === 'co' ? (
      <div class="mx-auto flex max-w-[1240px] flex-wrap justify-between gap-10 px-4 py-14 sm:px-[6vw] xl:px-0">
        <div class="flex flex-[1_1_260px] flex-col gap-3.5">
          <Image src={coLogoWhite} alt="Constructive Operations" width={190} height={96} class="h-24 w-[190px]" />
          <address class="text-[15px] not-italic text-on-navy">
            {site.company.address.join(', ')}
            <br />
            <a href={`mailto:${site.company.email}`} class={link}>{site.company.email}</a>
            <br />
            <a href={site.company.phoneHref} class={link}>{site.company.phone}</a>
          </address>
        </div>
        <div class="flex flex-[1_1_180px] flex-col gap-2 text-[15px]">
          <h2 class="font-display text-[15px] text-white">links.</h2>
          <a href={sundialUrl('/')} class={link}>Sundial</a>
          <a href={co('/privacy')} class={link}>Privacy</a>
          <a href={site.social.linkedin} rel="noopener" class={link}>LinkedIn</a>
          <a href={site.clientPortalUrl} rel="noopener" class={link}>Client Portal Login</a>
        </div>
        <p class="flex-[1_1_220px] self-end text-sm text-on-navy">© {year} {site.company.legalName}</p>
      </div>
    ) : (
      <div class="mx-auto flex max-w-[1240px] flex-wrap items-center justify-between gap-8 px-4 py-12 sm:px-[6vw] xl:px-0">
        <Image src={sundialLogoWhite} alt="Sundial" width={240} height={80} class="h-20 w-60" />
        <div class="flex flex-wrap gap-x-6 gap-y-2 text-[15px]">
          <a href={co('/services')} class={link}>Back-office services</a>
          <a href={co('/privacy')} class={link}>Privacy</a>
          <a href={site.social.linkedin} rel="noopener" class={link}>LinkedIn</a>
        </div>
        <p class="text-sm text-on-navy">© {year} {site.company.legalName}</p>
      </div>
    )
  }
</footer>
