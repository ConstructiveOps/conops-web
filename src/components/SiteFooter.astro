---
// Footer for both brands. The Client Portal Login link appears on the
// Constructive Operations footer ONLY — never on Sundial pages.
import { Image } from 'astro:assets';
import { site } from '../data/site';
import { coUrl, sundialUrl } from '../lib/urls';
import coLogoDark from '../assets/brand/co-logo-dark.png';

interface Props {
  brand: 'co' | 'sundial';
}
const { brand } = Astro.props;
const year = new Date().getFullYear();
const co = (path: string) => (brand === 'co' ? path : coUrl(path));
---

<footer class="bg-navy text-white">
  <div class="mx-auto grid max-w-6xl gap-10 px-4 py-12 sm:px-6 md:grid-cols-3">
    <div>
      {
        brand === 'co' ? (
          <Image src={coLogoDark} alt="Constructive Operations" width={180} height={91} class="h-[91px] w-[180px]" />
        ) : (
          <>
            <p class="font-heading text-2xl font-bold tracking-[0.2em]">SUNDIAL</p>
            <p class="mt-1 text-sm text-white/80">Operations Intelligence</p>
            <p class="mt-4 text-sm text-white/80">
              Sundial is built by{' '}
              <a href={co('/')} class="underline underline-offset-4">Constructive Operations</a>.
            </p>
          </>
        )
      }
    </div>

    <div>
      <h2 class="font-heading text-sm font-semibold lowercase text-white">contact.</h2>
      <address class="mt-3 space-y-1 text-sm not-italic text-white/85">
        {site.company.address.map((line) => <p>{line}</p>)}
        <p><a href={`mailto:${site.company.email}`} class="underline underline-offset-4">{site.company.email}</a></p>
        <p><a href={site.company.phoneHref} class="underline underline-offset-4">{site.company.phone}</a></p>
      </address>
    </div>

    <div>
      <h2 class="font-heading text-sm font-semibold lowercase text-white">links.</h2>
      <ul class="mt-3 space-y-1 text-sm text-white/85">
        {brand === 'co' && <li><a href={sundialUrl('/')} class="underline underline-offset-4">Sundial</a></li>}
        {brand === 'sundial' && <li><a href={co('/services')} class="underline underline-offset-4">Back-office services</a></li>}
        <li><a href={co('/privacy')} class="underline underline-offset-4">Privacy</a></li>
        <li><a href={site.social.linkedin} rel="noopener" class="underline underline-offset-4">LinkedIn</a></li>
        <li><a href={site.social.facebook} rel="noopener" class="underline underline-offset-4">Facebook</a></li>
        {
          brand === 'co' && (
            <li>
              <a href={site.clientPortalUrl} rel="noopener" class="underline underline-offset-4">Client Portal Login</a>
            </li>
          )
        }
      </ul>
    </div>
  </div>
  <div class="border-t border-white/15">
    <p class="mx-auto max-w-6xl px-4 py-4 text-xs text-white/75 sm:px-6">© {year} {site.company.legalName}</p>
  </div>
</footer>
