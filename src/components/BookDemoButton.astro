---
// The one call to action on both sites: "book a demo" (Microsoft Bookings).
// Never replace this with a login or any link into the demo portal.
import { site } from '../data/site';

interface Props {
  variant?: 'solid' | 'inverse' | 'outline';
  label?: string;
  class?: string;
}
const { variant = 'solid', label = 'Book a demo', class: className = '' } = Astro.props;
const styles = {
  solid: 'bg-navy text-white hover:bg-navy-deep',
  inverse: 'bg-white text-navy hover:bg-surface-alt',
  outline: 'border-2 border-navy text-navy hover:bg-navy hover:text-white',
};
---

<a
  href={site.bookingUrl}
  target="_blank"
  rel="noopener"
  class:list={[
    'inline-flex items-center justify-center gap-2 rounded-md px-5 py-3 font-heading text-sm font-semibold tracking-wide motion-safe:transition-colors',
    styles[variant],
    className,
  ]}
>
  {label}
  <span class="sr-only">(opens Microsoft Bookings in a new tab)</span>
</a>
