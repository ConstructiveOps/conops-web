---
// The one call to action on both sites: "book a demo" (Microsoft Bookings).
// Never replace this with a login or any link into the demo portal.
// The `accent` variant is for Sundial pages and the home Sundial section only.
import { site } from '../data/site';

interface Props {
  variant?: 'navy' | 'white' | 'outline' | 'outline-white' | 'accent';
  label?: string;
  size?: 'md' | 'lg';
  class?: string;
}
const { variant = 'navy', label = 'Book a demo', size = 'md', class: className = '' } = Astro.props;
const styles = {
  navy: 'bg-navy text-white hover:bg-navy-deep',
  white: 'bg-white text-navy hover:bg-on-navy',
  outline: 'border-[1.5px] border-navy bg-white text-navy hover:bg-surface-alt',
  'outline-white': 'border-[1.5px] border-white text-white hover:bg-white/10',
  accent: 'bg-accent text-on-accent hover:brightness-110',
};
const sizes = { md: 'px-[22px] py-3 text-[15px]', lg: 'px-7 py-[15px] text-[17px]' };
---

<a
  href={site.bookingUrl}
  target="_blank"
  rel="noopener"
  class:list={[
    'font-display inline-flex items-center justify-center rounded text-center leading-tight motion-safe:transition-colors',
    styles[variant],
    sizes[size],
    className,
  ]}
>
  {label}
  <span class="sr-only">(opens Microsoft Bookings in a new tab)</span>
</a>
