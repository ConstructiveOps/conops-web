---
// Header for both brands. The mobile menu uses <details>, so it needs no JavaScript.
// tone="navy" is the home page header, sitting on the navy hero.
import { Image } from 'astro:assets';
import BookDemoButton from './BookDemoButton.astro';
import { coNav, sundialNav } from '../data/site';
import { navHref, sundialUrl } from '../lib/urls';
import coLogoWide from '../assets/brand/co-logo-wide.png';
import coLogoWhite from '../assets/brand/co-logo-dark.png';
import sundialLogo from '../assets/brand/sundial-logo.png';

interface Props {
  brand: 'co' | 'sundial';
  tone?: 'light' | 'navy';
  /** Landing pages show only the logo and the CTA. */
  minimal?: boolean;
}
const { brand, tone = 'light', minimal = false } = Astro.props;
const navy = brand === 'co' && tone === 'navy';
const nav = brand === 'sundial' ? sundialNav : coNav;
const homeHref = brand === 'sundial' ? sundialUrl('/') : '/';
const ctaVariant = brand === 'sundial' ? 'accent' : navy ? 'white' : 'navy';
const bg = navy ? 'bg-navy on-dark' : brand === 'sundial' ? 'bg-sundial-panel border-b border-[#e3e6e9]' : 'bg-white border-b border-[#e3e6e9]';
const linkColor = navy ? 'text-white hover:text-on-navy' : 'text-navy hover:text-navy-deep';
---

<header class:list={['relative z-20', bg]}>
  <div class:list={['mx-auto flex max-w-[1440px] items-center justify-between gap-6 px-4 sm:px-[6vw]', brand === 'sundial' ? 'py-3.5' : navy ? 'py-[22px]' : 'py-5']}>
    <a href={homeHref} class="inline-flex shrink-0 items-center">
      {
        brand === 'sundial' ? (
          <Image src={sundialLogo} alt="Sundial, operations intelligence" width={180} height={60} loading="eager" class="h-[60px] w-[180px]" />
        ) : navy ? (
          <Image src={coLogoWhite} alt="Constructive Operations" width={126} height={64} loading="eager" class="h-16 w-[126px]" />
        ) : (
          <Image src={coLogoWide} alt="Constructive Operations" width={236} height={40} loading="eager" class="h-10 w-[236px]" />
        )
      }
    </a>

    {
      !minimal && (
        <nav aria-label="Main" class="font-display hidden items-center gap-7 text-[15px] lg:flex">
          <ul class="flex items-center gap-7">
            {nav.map((item) => (
              <li>
                <a href={navHref(item, brand)} class:list={['py-3 no-underline', linkColor]}>{item.label}</a>
              </li>
            ))}
          </ul>
          <BookDemoButton variant={ctaVariant} />
        </nav>
      )
    }

    {minimal && <BookDemoButton variant={ctaVariant} />}

    {
      !minimal && (
        <details class="group relative lg:hidden">
          <summary
            class:list={[
              'flex h-11 w-11 cursor-pointer list-none items-center justify-center rounded border [&::-webkit-details-marker]:hidden',
              navy ? 'border-white/60 text-white' : 'border-brand-gray text-navy',
            ]}
          >
            <span class="sr-only">Menu</span>
            <svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M4 7h16M4 12h16M4 17h16" class="group-open:hidden" />
              <path d="M6 6l12 12M18 6L6 18" class="hidden group-open:block" />
            </svg>
          </summary>
          <nav aria-label="Main" class="absolute right-0 z-40 mt-2 w-64 rounded border border-line bg-white p-4 shadow-lg">
            <ul class="font-display space-y-2 text-navy">
              {nav.map((item) => (
                <li>
                  <a href={navHref(item, brand)} class="block py-2">{item.label}</a>
                </li>
              ))}
            </ul>
            <BookDemoButton variant={brand === 'sundial' ? 'accent' : 'navy'} class="mt-4 w-full" />
          </nav>
        </details>
      )
    }
  </div>
</header>
