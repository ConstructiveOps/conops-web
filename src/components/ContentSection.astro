---
// One anchor section from a page's `sections` list.
import SectionHeading from './SectionHeading.astro';
import Text from './Text.astro';

interface Props {
  section: { id: string; heading: string; paragraphs: string[]; bullets: string[] };
  tone?: 'plain' | 'alt' | 'navy';
}
const { section, tone = 'plain' } = Astro.props;
const bg = { plain: 'bg-white', alt: 'bg-surface-alt', navy: 'bg-navy' }[tone];
const textTone = tone === 'navy' ? 'text-white/90' : 'text-ink-muted';
---

<section id={section.id} aria-labelledby={`${section.id}-heading`} class:list={[bg, 'scroll-mt-6']}>
  <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
    <SectionHeading id={`${section.id}-heading`} text={section.heading} tone={tone === 'navy' ? 'white' : 'navy'} />
    <div class:list={['mt-4 max-w-3xl space-y-4 text-lg', textTone]}>
      {section.paragraphs.map((p) => <Text text={p} />)}
    </div>
    {
      section.bullets.length > 0 && (
        <ul class:list={['mt-6 max-w-3xl list-disc space-y-2 pl-6 text-lg', textTone]}>
          {section.bullets.map((b) => <Text as="li" text={b} />)}
        </ul>
      )
    }
    <slot />
  </div>
</section>
