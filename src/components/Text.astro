---
// Renders one string of copy. Strings that start with "PLACEHOLDER:" get a
// visible badge and dashed outline so unfinished copy can't be missed.
interface Props {
  text: string;
  as?: 'p' | 'span' | 'li';
  class?: string;
}
const { text, as: Tag = 'p', class: className = '' } = Astro.props;
const isPlaceholder = /^PLACEHOLDER:/i.test(text.trim());
const body = isPlaceholder ? text.trim().replace(/^PLACEHOLDER:\s*/i, '') : text;
---

<Tag class:list={[className, isPlaceholder && 'placeholder']}>
  {isPlaceholder && <span class="placeholder-badge">Placeholder</span>}
  {body}
</Tag>
