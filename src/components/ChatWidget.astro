---
// Chat assistant launcher (bottom-right corner of every page on both sites).
// The panel's code (islands/ChatPanel.tsx) downloads only when the visitor
// first opens it. While site.chatWidget.enabled is false this renders nothing.
// The assistant never links to, names or describes the demo portal; the
// server enforces that too (api/_lib/filter.ts).
import { site } from '../data/site';

interface Props {
  brand: 'co' | 'sundial';
}
const { brand } = Astro.props;
const title = brand === 'sundial' ? 'Ask Sundial' : 'Ask Constructive Operations';
const launcher =
  brand === 'sundial'
    ? 'bg-accent text-on-accent hover:brightness-95'
    : 'bg-navy text-white hover:bg-navy-deep';
---

{
  site.chatWidget.enabled && (
    <div
      data-chat-widget
      data-brand={brand}
      data-title={title}
      data-endpoint={site.chatWidget.endpoint}
      data-booking={site.bookingUrl}
      data-email={site.company.email}
      data-phone={site.company.phone}
      data-phone-href={site.company.phoneHref}
    >
      <button
        type="button"
        hidden
        data-chat-launcher
        aria-haspopup="dialog"
        aria-expanded="false"
        aria-controls="chat-panel"
        class:list={['fixed bottom-4 right-4 z-40 flex size-14 items-center justify-center rounded-full shadow-[0_6px_18px_rgba(2,53,104,0.28)]', launcher]}
      >
        <span class="sr-only">{title}</span>
        <svg aria-hidden="true" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 12a8 8 0 0 1-11.6 7.1L4 20.5l1.4-5A8 8 0 1 1 21 12z" />
        </svg>
      </button>
      <div data-chat-root></div>
    </div>
  )
}

<script>
  const host = document.querySelector<HTMLElement>('[data-chat-widget]');
  const button = host?.querySelector<HTMLButtonElement>('[data-chat-launcher]');
  const root = host?.querySelector<HTMLElement>('[data-chat-root]');
  if (host && button && root) {
    button.hidden = false;
    let state: 'idle' | 'loading' | 'ready' = 'idle';
    const open = async () => {
      if (state === 'loading') return; // still downloading: ignore extra clicks
      if (state === 'ready') {
        const next = button.getAttribute('aria-expanded') !== 'true';
        window.dispatchEvent(new CustomEvent('conops-chat-set', { detail: next }));
        return;
      }
      state = 'loading';
      const { mountChat } = await import('./islands/ChatPanel');
      state = 'ready';
      const d = host.dataset;
      mountChat(root, button, {
        brand: d.brand === 'sundial' ? 'sundial' : 'co',
        title: d.title ?? '',
        endpoint: d.endpoint ?? '',
        bookingUrl: d.booking ?? '',
        email: d.email ?? '',
        phone: d.phone ?? '',
        phoneHref: d.phoneHref ?? '',
      });
    };
    button.addEventListener('click', open);
    // Re-open on the next page if the panel was open (this browser tab only).
    try {
      if (sessionStorage.getItem('conops-chat-open') === '1') open();
    } catch {
      /* storage blocked */
    }
  }
</script>
