# Settings for the /api functions (contact form and chat assistant).
# Real values go in Vercel → Settings → Environment Variables, and, for local
# testing only, in .env.local (git-ignored). Never put real values in this file.

# --- Salesforce Web-to-Lead (contact form and chat leads) ---------------------
# If SF_ORG_ID or any SF_FIELD_* is missing, the contact form shows the
# "email us or book a demo" fallback and the chat cannot pass on details.
SF_ORG_ID=00D000000000000
# The 00N… codes of the five custom Lead fields (from the generated Web-to-Lead HTML).
SF_FIELD_TEXT_CONSENT=00N000000000001
SF_FIELD_SITE=00N000000000002
SF_FIELD_PAGE=00N000000000003
SF_FIELD_CHANNEL=00N000000000004
SF_FIELD_TEST=00N000000000005
# Optional: the form address from the generated HTML, if it is not the default
# https://webto.salesforce.com/servlet/servlet.WebToLead?encoding=UTF-8
SF_WEB_TO_LEAD_URL=
# Optional, for first tests only: Salesforce emails a debug report per lead.
SF_DEBUG_EMAIL=

# live | test | dry-run. A lead is live ONLY when this is "live" AND
# site.launched is true in src/data/site.ts. Anything else creates test leads
# (Website Test Lead ticked, "[TEST]" in Description, no alert email).
# dry-run sends nothing (local testing).
LEAD_MODE=test

# --- Chat assistant ----------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-dummy
# Must be exactly "true" for the chat to answer. Anything else = off.
CHAT_ENABLED=true
# Optional. Default claude-sonnet-5-5. Alternatives: claude-haiku-5-5, claude-opus-5-5.
CHAT_MODEL=
# Private block list for chat replies: comma-separated terms, including the
# demo portal's address. Mark as Sensitive in Vercel.
DENY_TERMS=

# --- Limits ------------------------------------------------------------------
# Long random text used to scramble visitor addresses for the rate limits.
RATE_LIMIT_SALT=change-me
# Added by Vercel when the Upstash Redis store is connected to the project.
KV_REST_API_URL=
KV_REST_API_TOKEN=
